#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

VERSION="$1"
ARCH="$(dpkg --print-architecture)"

ARCHIVE="/downloads/go${VERSION}.linux-${ARCH}.tar.gz"
URL="https://go.dev/dl/go${VERSION}.linux-${ARCH}.tar.gz"

if [[ ! -f "${ARCHIVE}" ]]; then
    curl --fail --silent --show-error --location \
        --output "${ARCHIVE}" "${URL}"
fi

tar --extract --gzip \
    --directory=/usr/local \
    --file="${ARCHIVE}"

# Drop the parts of the distribution that only matter to people developing Go
# itself: the toolchain's own test suite, the API compatibility manifests, the
# documentation sources, and the editor and wasm odds and ends. src stays --
# the toolchain compiles the standard library from it -- and so does lib, which
# holds the wasm exec shims and the time zone database.
rm --recursive --force \
    /usr/local/go/api \
    /usr/local/go/doc \
    /usr/local/go/misc \
    /usr/local/go/test

# The distribution ships more than one binary (go, gofmt); expose each of
# them on PATH.
for TOOL in /usr/local/go/bin/*; do
    ln --symbolic --force "${TOOL}" "/usr/local/bin/$(basename "${TOOL}")"
done
