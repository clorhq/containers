#!/bin/bash
# Build the images referenced by official space configs for amd64 + arm64 and
# push them to GHCR under ghcr.io/clorhq. This is the laptop publish path; CI
# does the same with the official Docker actions. Host-side; runs on macOS bash
# 3.2.
set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "${REPO_ROOT}"

REGISTRY="ghcr.io/clorhq"
PLATFORMS="linux/amd64,linux/arm64"
GIT_SHA="$(git rev-parse --short HEAD)"
EXTRA_BUILD_ARGS="${EXTRA_BUILD_ARGS:-}"
CLOR_BUILD_NONCE="${CLOR_BUILD_NONCE:-$(date +%s)-$$}"

BASE_IMAGE="${REGISTRY}/software-development-base"

echo "==> building and pushing ${BASE_IMAGE}"
docker buildx build --push \
    --platform "${PLATFORMS}" \
    --tag "${BASE_IMAGE}:latest" \
    --tag "${BASE_IMAGE}:${GIT_SHA}" \
    --file images/base/Dockerfile \
    --build-arg "CLOR_BUILD_NONCE=${CLOR_BUILD_NONCE}" \
    ${EXTRA_BUILD_ARGS} \
    .

for VARIANT in desktop devops; do
    IMAGE="${REGISTRY}/software-development-${VARIANT}"
    echo "==> building and pushing ${IMAGE}"
    docker buildx build --push \
        --platform "${PLATFORMS}" \
        --tag "${IMAGE}:latest" \
        --tag "${IMAGE}:${GIT_SHA}" \
        --file "images/${VARIANT}/Dockerfile" \
        --build-arg "BASE_IMAGE=${BASE_IMAGE}:latest" \
        ${EXTRA_BUILD_ARGS} \
        .
done

DATA_IMAGE="${REGISTRY}/software-development-data"
echo "==> building and pushing ${DATA_IMAGE}"
docker buildx build --push \
    --platform "${PLATFORMS}" \
    --tag "${DATA_IMAGE}:latest" \
    --tag "${DATA_IMAGE}:${GIT_SHA}" \
    --file images/data/Dockerfile \
    --build-arg "BASE_IMAGE=${BASE_IMAGE}:latest" \
    ${EXTRA_BUILD_ARGS} \
    .
