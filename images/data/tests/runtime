#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

IMAGE="${1:?usage: runtime IMAGE}"
CONTAINER="clor-data-test-${RANDOM}-$$"
REPOSITORY="$(mktemp --directory)"
HEADERS="$(mktemp)"
BODY="$(mktemp)"
cleanup() {
    docker rm --force "${CONTAINER}" >/dev/null 2>&1 || true
    rm --force "${HEADERS}" "${BODY}"
}
trap cleanup EXIT INT TERM
chmod 0777 "${REPOSITORY}"

# JUPYTER_PLATFORM_DIRS mirrors images/data/services/jupyterlab.toml, because it
# is what decides whether the shipped jupyter_server_config.py is found at all.
docker run --detach --name "${CONTAINER}" \
    --volume "${REPOSITORY}:/home/user/repository" \
    --publish 127.0.0.1::8888 \
    --publish 127.0.0.1::2718 \
    "${IMAGE}" \
    bash --login -c '
        cd /home/user/repository
        JUPYTER_PLATFORM_DIRS=1 jupyter-lab --no-browser --ip=0.0.0.0 --port=8888 \
            --ServerApp.root_dir=. --ServerApp.token= \
            --ServerApp.password= --IdentityProvider.token= &
        marimo edit notebook.py --no-token --headless --host 0.0.0.0 --port 2718 &
        wait
    ' >/dev/null

jupyter_port="$(docker port "${CONTAINER}" 8888/tcp | sed -n '1s/.*://p')"
marimo_port="$(docker port "${CONTAINER}" 2718/tcp | sed -n '1s/.*://p')"
[[ -n "${jupyter_port}" && -n "${marimo_port}" ]]

for _ in $(seq 1 60); do
    jupyter_status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
        "http://127.0.0.1:${jupyter_port}/api" || true)"
    marimo_status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
        "http://127.0.0.1:${marimo_port}/" || true)"
    if [[ "${jupyter_status}" = 200 && "${marimo_status}" = 200 ]]; then
        break
    fi
    sleep 1
done
[[ "${jupyter_status}" = 200 ]]
[[ "${marimo_status}" = 200 ]]
[[ -f "${REPOSITORY}/notebook.py" ]]
curl --silent --show-error --fail --output "${BODY}" \
    "http://127.0.0.1:${marimo_port}/"
grep --fixed-strings --quiet \
    '<marimo-filename hidden>/home/user/repository/notebook.py</marimo-filename>' "${BODY}"

# The tab is an iframe on clor.com, so Jupyter's stock "frame-ancestors 'self'"
# blocks it: a browser enforces every policy it receives, and that one
# intersects the Clor edge's allowlist down to nothing.
curl --silent --output /dev/null --dump-header "${HEADERS}" \
    "http://127.0.0.1:${jupyter_port}/lab"
grep --ignore-case --fixed-strings --quiet \
    'content-security-policy: frame-ancestors *' "${HEADERS}"
if grep --fixed-strings --quiet "frame-ancestors 'self'" "${HEADERS}"; then
    printf 'jupyter still sends the default frame-ancestors policy\n' >&2
    exit 1
fi

# Cross-origin and cookie-less, exactly as the browser sends it from inside the
# iframe. Without allow_origin, APIHandler.prepare masks the failed origin check
# as a 404; with it but no disable_check_xsrf, the missing _xsrf cookie is a 403.
# So a 201 proves both took effect -- and that the clor-data kernelspec starts.
kernel_status="$(curl --silent --output "${BODY}" --write-out '%{http_code}' \
    --header 'Origin: https://example.clor.host' \
    --header 'Content-Type: application/json' \
    --data '{"name": "clor-data"}' \
    "http://127.0.0.1:${jupyter_port}/api/kernels")"
[[ "${kernel_status}" = 201 ]]
kernel_id="$(sed -n 's/.*"id": *"\([^"]*\)".*/\1/p' "${BODY}")"
[[ -n "${kernel_id}" ]]
curl --silent --show-error --fail --request DELETE \
    --header 'Origin: https://example.clor.host' \
    "http://127.0.0.1:${jupyter_port}/api/kernels/${kernel_id}"

[[ "$(docker exec --user user --workdir /home/user/repository "${CONTAINER}" pwd)" = /home/user/repository ]]
docker exec --user user "${CONTAINER}" \
    /home/user/.local/share/clor/data-venv/bin/python -c \
    'import duckdb, ipykernel, marimo, pandas, polars, pyarrow'
